{
	"name": "cyberplace-root",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"bundle": "universal-plugin plugin bundle --root plugins/cyberspace",
		"check": "biome check --write",
		"check:ci": "biome ci",
		"cp": "pnpm run --filter=cyberplace",
		"cs": "changeset",
		"knip": "knip",
		"prepare": "node -e \"if(!(process.env.CI||process.env.GITHUB_ACTIONS))require('child_process').execSync('husky',{stdio:'inherit'})\"",
		"release": "changeset publish",
		"render:awesome-list": "pnpm --filter=cyberplace render:awesome-list",
		"test": "turbo test",
		"typecheck": "turbo typecheck",
		"verify": "turbo verify",
		"version": "changeset version && pnpm run bundle",
		"web": "pnpm run --filter=website"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@repobuddy/biome": "^2.3.1",
		"@types/node": "^24.12.4",
		"husky": "^9.1.7",
		"knip": "^6.14.1",
		"turbo": "^2.9.14",
		"typescript": "^6.0.0",
		"universal-plugin": "0.2.2"
	},
	"packageManager": "pnpm@11.0.0",
	"engines": {
		"node": ">=22"
	}
}
